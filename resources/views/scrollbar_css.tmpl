{{ define "scrollbar_css" }}
        html, body {
            height: 100%;
        }
        body.app-shell {
            display: flex;
            flex-direction: column;
            margin: 0;
            overflow: hidden;
        }
        .app-scroll {
            flex: 1 1 auto;
            min-height: 0;
            min-width: 0;
            overflow: auto;
        }
        .app-editor-main {
            flex: 1 1 0;
            min-height: 0;
            min-width: 0;
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: minmax(0, 1fr);
        }
        .app-editor-main.is-split {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }
        @media (max-width: 767px) {
            .app-editor-main.is-split {
                grid-template-columns: minmax(0, 1fr);
                grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
            }
        }
        .app-editor-col {
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
        }
        #preview-col {
            overflow: auto;
            overscroll-behavior: contain;
        }
        .app-editor-fill {
            box-sizing: border-box;
            flex: 1 1 0;
            margin: 0;
            width: 100%;
            min-width: 0;
            min-height: 0;
            overflow: auto;
            overscroll-behavior: contain;
        }
        #preview-col .app-editor-fill {
            flex: 1 0 auto;
            width: auto;
            min-width: 100%;
            min-height: 100%;
            overflow: visible;
        }
        #code-block.nowrap,
        #code-block.nowrap code.hljs,
        #preview.nowrap,
        #preview.nowrap code.hljs {
            display: block;
            width: max-content;
            min-width: 100%;
        }
        #preview-col::-webkit-scrollbar-track {
            background: #101010;
        }
        html {
            scrollbar-width: thin;
            scrollbar-color: #333333 #050505;
        }
        *::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }
        *::-webkit-scrollbar-track {
            background: #050505;
        }
        *::-webkit-scrollbar-thumb {
            background: #333333;
            border-radius: 5px;
            border: 2px solid #050505;
        }
        *::-webkit-scrollbar-thumb:hover {
            background: #444444;
        }
        *::-webkit-scrollbar-corner {
            background: #050505;
        }
{{ end }}
