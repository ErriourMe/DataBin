{{ define "paste_stats_gate.tmpl" }}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .id }} stats | {{ .appName }}</title>
{{ template "head_meta" . }}
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="app-shell flex h-full flex-col bg-[#141414] text-gray-200 antialiased">
<header class="flex flex-shrink-0 items-center justify-between px-3 py-1.5 bg-[#141414] text-sm">
    <a href="/" class="group inline-flex">{{ template "brand_logo" . }}</a>
    <span class="font-mono text-sm text-white">{{ .id }}</span>
</header>
<main class="flex flex-1 flex-col items-center justify-center px-4 py-8">
    <div class="w-full max-w-sm rounded-lg border border-[#2a2a2a] bg-[#1c1c1c] p-6 shadow-lg">
        <h1 class="mb-1 text-center text-lg font-medium text-white">Paste statistics</h1>
        <p class="mb-5 text-center text-sm text-gray-500">Enter the token you received when creating this paste</p>
        {{ if .wrongToken }}
        <p class="mb-4 text-center text-sm text-red-400">Invalid token</p>
        {{ end }}
        <form method="post" action="/{{ .id }}/stats" class="space-y-4">
            <div>
                <label for="token" class="mb-1 block text-xs text-gray-500">Token</label>
                <input id="token" name="token" type="password" autocomplete="off" required
                    class="w-full rounded border border-[#2a2a2a] bg-[#141414] px-3 py-2 text-sm text-gray-200 outline-none focus:border-[#00d3a3]">
            </div>
            <button type="submit" class="btn-accent w-full rounded px-3 py-2 text-sm font-medium">View stats</button>
        </form>
    </div>
</main>
{{ template "footer_credit" . }}
</body>
</html>
{{ end }}
