{{ define "paste_new.tmpl" }}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .appName }}</title>
{{ template "head_meta" . }}
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/styles/atom-one-dark.min.css">
{{ template "highlight_scripts" . }}
    <style>
{{ template "scrollbar_css" . }}
        #editor { tab-size: 4; }
        #preview code.hljs { padding: 0; background: transparent !important; }
        #preview.wrap { white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; width: 100%; }
        #preview.nowrap { white-space: pre; }
        #preview-col #preview.wrap { width: 100%; max-width: 100%; }
        #editor.wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
        #editor.nowrap { white-space: pre; }
    </style>
</head>
<body class="app-shell h-full bg-[#141414] text-gray-200 antialiased">
<header class="flex flex-shrink-0 items-center justify-between px-3 py-1.5 bg-[#141414] text-sm">
    {{ template "brand_logo" . }}
    <div class="flex items-center gap-2">
        <label class="flex cursor-pointer select-none items-center gap-1.5 text-gray-500 hover:text-gray-300">
            <input id="wrap" type="checkbox" class="accent-brand rounded border-gray-600 bg-[#141414] focus:ring-0 focus:ring-offset-0">
            <span>Word wrap</span>
        </label>
        <label class="text-gray-500 hidden sm:inline">Language</label>
        <select id="lang" class="h-7 bg-[#1c1c1c] border border-[#2a2a2a] rounded px-2 text-sm text-gray-300">
            <option value="">auto</option>
            <option value="plaintext">plaintext</option>
            <option value="go">Go</option>
            <option value="javascript">JavaScript</option>
            <option value="typescript">TypeScript</option>
            <option value="python">Python</option>
            <option value="rust">Rust</option>
            <option value="json">JSON</option>
            <option value="yaml">YAML</option>
            <option value="bash">Bash</option>
            <option value="sql">SQL</option>
            <option value="xml">XML</option>
            <option value="html">HTML</option>
            <option value="css">CSS</option>
        </select>
        <button id="preview-toggle" type="button" aria-pressed="false" class="inline-flex h-7 items-center justify-center rounded px-2.5 text-sm text-gray-300 bg-[#1c1c1c] hover:bg-[#252525]">
            Preview
        </button>
        <button id="options-open" type="button" title="Paste options" aria-label="Paste options" class="inline-flex h-7 w-7 items-center justify-center rounded text-gray-300 bg-[#1c1c1c] hover:bg-[#252525]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>
            </svg>
        </button>
        <button id="save" type="button" disabled class="btn-accent inline-flex h-7 items-center justify-center gap-1.5 rounded px-2.5 text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                <polyline points="17 21 17 13 7 13 7 21"/>
                <polyline points="7 3 7 8 15 8"/>
            </svg>
            Save
        </button>
    </div>
</header>
<main id="main-pane" class="app-editor-main">
    <div class="app-editor-col">
        <textarea id="editor" class="app-editor-fill nowrap resize-none border-0 bg-[#050505] text-gray-200 p-3 font-mono text-sm outline-none" spellcheck="false" placeholder="Paste or type here…"></textarea>
    </div>
    <div id="preview-col" class="app-editor-col hidden">
        <pre id="preview" class="app-editor-fill nowrap m-0 bg-[#101010] p-3 text-sm leading-relaxed"><code class="hljs language-plaintext"></code></pre>
    </div>
</main>
<p id="status" class="fixed bottom-3 left-3 text-xs text-gray-600"></p>
<div id="options-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4" role="dialog" aria-modal="true" aria-labelledby="options-title">
    <div class="w-full max-w-sm rounded-lg border border-[#2a2a2a] bg-[#1c1c1c] p-6 shadow-xl">
        <div class="mb-4 flex items-center justify-between">
            <h2 id="options-title" class="text-lg font-medium text-white">Paste options</h2>
            <button type="button" id="options-close" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-transparent text-gray-400 transition hover:border-[#2a2a2a] hover:bg-[#252525] hover:text-gray-200" aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
                    <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="space-y-4">
            <div>
                <label class="flex cursor-pointer select-none items-center gap-3 text-sm font-medium text-gray-200">
                    <input id="burn" type="checkbox" class="accent-brand rounded border-gray-600 bg-[#141414] focus:ring-0 focus:ring-offset-0">
                    <span>Burn after reading</span>
                </label>
                <div id="burn-views-wrap" class="mt-4 hidden space-y-4">
                    <div>
                        <label for="burn-views" class="mb-2 block text-sm font-medium text-gray-200">How many times to show before delete</label>
                        <input id="burn-views" type="number" min="0" max="99" value="1" inputmode="numeric"
                            class="w-full rounded border border-[#2a2a2a] bg-[#141414] px-3 py-2 text-sm text-gray-200 focus:border-[#00d3a3] focus:outline-none">
                    </div>
                    <label class="flex cursor-pointer select-none items-center gap-3 text-sm font-medium text-gray-200">
                        <input id="burn-unique" type="checkbox" class="accent-brand rounded border-gray-600 bg-[#141414] focus:ring-0 focus:ring-offset-0" checked>
                        <span>Count unique viewers only</span>
                    </label>
                </div>
            </div>
            <div>
                <label for="doc-password" class="mb-2 block text-sm font-medium text-gray-200">View password</label>
                <input id="doc-password" type="password" autocomplete="new-password" placeholder="Leave empty for no password"
                    class="w-full rounded border border-[#2a2a2a] bg-[#141414] px-3 py-2 text-sm text-gray-200 placeholder:text-gray-600 focus:border-[#00d3a3] focus:outline-none">
            </div>
        </div>
        <button type="button" id="options-done" class="btn-accent mt-6 w-full rounded px-3 py-2 text-sm font-medium">Done</button>
    </div>
</div>
{{ template "footer_credit" . }}
{{ template "highlight_fn" . }}
<script>
const editor = document.getElementById('editor');
const preview = document.getElementById('preview');
const previewCode = preview.querySelector('code');
const mainPane = document.getElementById('main-pane');
const previewCol = document.getElementById('preview-col');
const previewToggle = document.getElementById('preview-toggle');
const langSelect = document.getElementById('lang');
const statusEl = document.getElementById('status');
const wrapCheck = document.getElementById('wrap');
const saveBtn = document.getElementById('save');
const burnCheck = document.getElementById('burn');
const burnViewsWrap = document.getElementById('burn-views-wrap');
const burnViewsInput = document.getElementById('burn-views');
const burnUniqueCheck = document.getElementById('burn-unique');
const docPassword = document.getElementById('doc-password');
const optionsModal = document.getElementById('options-modal');
const optionsOpen = document.getElementById('options-open');
function syncSaveButton() {
    const canSave = editor.value.trim().length > 0;
    saveBtn.disabled = !canSave;
}

syncSaveButton();

function syncBurnViewsField() {
    burnViewsWrap.classList.toggle('hidden', !burnCheck.checked);
}

function syncOptionsIndicator() {
    const active = burnCheck.checked || (docPassword.value && docPassword.value.length > 0);
    optionsOpen.classList.toggle('text-[#00d3a3]', active);
    optionsOpen.classList.toggle('ring-1', active);
    optionsOpen.classList.toggle('ring-[#00d3a3]/40', active);
}
burnCheck.addEventListener('change', () => {
    syncBurnViewsField();
    syncOptionsIndicator();
});
syncBurnViewsField();
docPassword.addEventListener('input', syncOptionsIndicator);
syncOptionsIndicator();

function openOptionsModal() {
    optionsModal.classList.remove('hidden');
    optionsModal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
}
function closeOptionsModal() {
    optionsModal.classList.add('hidden');
    optionsModal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
    syncOptionsIndicator();
}
optionsOpen.addEventListener('click', openOptionsModal);
document.getElementById('options-close').addEventListener('click', closeOptionsModal);
document.getElementById('options-done').addEventListener('click', closeOptionsModal);
optionsModal.addEventListener('click', (e) => { if (e.target === optionsModal) closeOptionsModal(); });
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !optionsModal.classList.contains('hidden')) closeOptionsModal();
});

function isPreviewOpen() {
    return !previewCol.classList.contains('hidden');
}

function setPreviewOpen(on) {
    previewCol.classList.toggle('hidden', !on);
    mainPane.classList.toggle('is-split', on);
    previewToggle.setAttribute('aria-pressed', on ? 'true' : 'false');
    previewToggle.classList.toggle('bg-[#252525]', on);
    previewToggle.classList.toggle('text-white', on);
    previewToggle.classList.toggle('text-gray-300', !on);
    try { localStorage.setItem('databin-preview', on ? '1' : '0'); } catch (_) {}
    if (on) refreshPreview();
}

previewToggle.addEventListener('click', () => setPreviewOpen(!isPreviewOpen()));

setPreviewOpen((function () {
    try { return localStorage.getItem('databin-preview') === '1'; } catch (_) { return false; }
})());

(function loadForkDraft() {
    if (new URLSearchParams(window.location.search).get('fork') !== '1') return;
    try {
        const raw = sessionStorage.getItem('databin-fork');
        sessionStorage.removeItem('databin-fork');
        if (!raw) return;
        const payload = JSON.parse(raw);
        if (!payload || typeof payload.content !== 'string') return;
        editor.value = payload.content;
        if (payload.lang) langSelect.value = payload.lang;
        syncSaveButton();
        if (isPreviewOpen()) refreshPreview();
        if (payload.from) {
            statusEl.textContent = 'Fork of ' + payload.from + ': save to create a new paste';
        } else {
            statusEl.textContent = 'Fork: save to create a new paste';
        }
    } catch (_) {}
    try { history.replaceState(null, '', '/'); } catch (_) {}
})();

function applyWrap(on) {
    [editor, preview].forEach((el) => {
        el.classList.toggle('wrap', on);
        el.classList.toggle('nowrap', !on);
    });
    try { localStorage.setItem('databin-wrap', on ? '1' : '0'); } catch (_) {}
}

wrapCheck.checked = (function () {
    try { return localStorage.getItem('databin-wrap') === '1'; } catch (_) { return false; }
})();
applyWrap(wrapCheck.checked);
wrapCheck.addEventListener('change', () => applyWrap(wrapCheck.checked));

function refreshPreview() {
    databinHighlight(previewCode, editor.value, langSelect.value);
}

editor.addEventListener('input', () => {
    syncSaveButton();
    if (isPreviewOpen()) refreshPreview();
});
langSelect.addEventListener('change', () => { if (isPreviewOpen()) refreshPreview(); });

saveBtn.addEventListener('click', async () => {
    if (saveBtn.disabled) return;
    statusEl.textContent = 'Saving…';
    try {
        const headers = { 'Content-Type': 'text/plain; charset=utf-8' };
        if (burnCheck.checked) {
            headers['X-Databin-Burn'] = '1';
            let shows = parseInt(burnViewsInput.value, 10);
            if (!Number.isFinite(shows)) shows = 1;
            shows = Math.min(99, Math.max(0, shows));
            headers['X-Databin-Burn-Views'] = String(shows);
            if (!burnUniqueCheck.checked) headers['X-Databin-Burn-Unique'] = '0';
        }
        const pwd = docPassword && docPassword.value ? docPassword.value : '';
        if (pwd) headers['X-Databin-Password'] = pwd;
        const res = await fetch('/documents', { method: 'POST', headers, body: editor.value });
        const raw = (await res.text()).trim();
        if (!res.ok) {
            if (res.status === 429) {
                statusEl.textContent = 'Too many saves, try again in a minute';
                return;
            }
            statusEl.textContent = raw || 'Save failed';
            return;
        }
        let data;
        try { data = JSON.parse(raw); } catch (_) {
            statusEl.textContent = 'Invalid server response';
            return;
        }
        const lang = langSelect.value;
        const q = lang ? ('?lang=' + encodeURIComponent(lang)) : '';
        const viewURL = '/' + data.id + q;
        try {
            sessionStorage.setItem('databin-token-' + data.id, data.token);
            sessionStorage.setItem('databin-show-token-' + data.id, '1');
        } catch (_) {}
        window.location.href = viewURL;
    } catch (e) {
        statusEl.textContent = 'Network error';
    }
});

document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        if (!saveBtn.disabled) saveBtn.click();
    }
});
</script>
</body>
</html>
{{ end }}
