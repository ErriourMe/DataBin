{{ define "paste_password.tmpl" }}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .id }} | {{ .appName }}</title>
{{ template "head_meta" . }}
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="app-shell flex h-full flex-col bg-[#141414] text-gray-200 antialiased">
<header class="flex flex-shrink-0 items-center justify-between px-3 py-1.5 bg-[#141414] text-sm">
    <a href="/" class="group inline-flex">{{ template "brand_logo" . }}</a>
    <span class="font-mono text-sm text-white">{{ .id }}</span>
</header>
<main class="flex flex-1 flex-col items-center justify-center px-4 py-8">
    <div class="w-full max-w-sm rounded-lg border border-[#2a2a2a] bg-[#1c1c1c] p-6 shadow-lg">
        <h1 class="mb-1 text-center text-lg font-medium text-white">Password required</h1>
        <p class="mb-5 text-center text-sm text-gray-500">This paste is protected. Enter the password to view it.</p>
        {{ if .wrongPassword }}
        <p class="mb-4 text-center text-sm text-red-400">Incorrect password.</p>
        {{ end }}
        <form method="post" action="/{{ .id }}{{ if .lang }}?lang={{ .lang }}{{ end }}" class="space-y-4">
            <div>
                <label for="password" class="mb-1 block text-xs text-gray-500">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required
                    class="w-full rounded border border-[#2a2a2a] bg-[#141414] px-3 py-2 text-sm text-gray-200 outline-none focus:border-[#00d3a3]">
            </div>
            <button type="submit" class="btn-accent w-full rounded px-3 py-2 text-sm font-medium">Unlock</button>
        </form>
    </div>
</main>
{{ template "footer_credit" . }}
</body>
</html>
{{ end }}
