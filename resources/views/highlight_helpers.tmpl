{{ define "highlight_scripts" }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/languages/php.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/languages/sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/languages/json.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/languages/yaml.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.2/languages/bash.min.js"></script>
{{ end }}
{{ define "highlight_fn" }}
<script>
function databinHighlight(codeEl, text, lang) {
    if (!window.hljs || !codeEl) return;
    const raw = text != null ? text : codeEl.textContent;
    const subset = [
        'php', 'sql', 'json', 'javascript', 'typescript', 'xml', 'yaml', 'bash',
        'go', 'python', 'rust', 'java', 'csharp', 'ruby', 'kotlin', 'dockerfile',
        'nginx', 'markdown', 'css', 'html', 'plaintext'
    ];
    let result;
    if (lang) {
        try {
            result = hljs.highlight(raw, { language: lang, ignoreIllegals: true });
        } catch (_) {
            result = hljs.highlightAuto(raw, subset);
        }
    } else {
        result = hljs.highlightAuto(raw, subset);
    }
    codeEl.className = 'hljs' + (result.language ? (' language-' + result.language) : '');
    codeEl.innerHTML = result.value;
}
</script>
{{ end }}
