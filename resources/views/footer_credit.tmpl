{{ define "footer_credit" }}
<aside class="pointer-events-none fixed bottom-0 right-0 z-20">
    <p class="pointer-events-auto bg-[#141414] px-2 py-1 text-xs text-gray-500">
        {{ .footerCopyright }} © by
        <a href="https://erriour.ru/?utm_source=databin" class="text-gray-400 no-underline hover:text-[#1adfb0]" rel="noopener noreferrer" target="_blank">Erriour</a>
        <a href="{{ .appVersionURL }}" class="text-gray-600 no-underline hover:text-[#1adfb0]" rel="noopener noreferrer" target="_blank">v{{ .appVersion }}</a>{{ if .updateVersion }}<span class="text-gray-600"> (<a href="{{ .updateVersionURL }}" class="no-underline hover:text-[#1adfb0]" rel="noopener noreferrer" target="_blank">v{{ .updateVersion }} available</a>)</span>{{ end }}
    </p>
</aside>
{{ end }}
