{{ define "head_meta" }}
    <link rel="icon" href="/public/favicon.png" type="image/png">
    <meta name="description" content="Self-hosted paste tool for sharing data">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ .appName }}">
    <meta property="og:title" content="{{ .ogTitle }}">
    <meta property="og:description" content="Self-hosted paste tool for sharing data">
    <meta property="og:image" content="{{ .ogImageURL }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ .ogTitle }}">
    <meta name="twitter:description" content="Self-hosted paste tool for sharing data">
    <meta name="twitter:image" content="{{ .ogImageURL }}">
{{ end }}
