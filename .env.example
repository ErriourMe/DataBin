APP_NAME=DataBin
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost:3000
APP_HOST=127.0.0.1
APP_PORT=3000

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=changeme
REDIS_PORT=6379
REDIS_DB=0

CACHE_STORE=redis

# Paste settings (0 = never expire)
PASTE_TTL_HOURS=0
PASTE_MAX_BYTES=2097152
PASTE_KEY_LENGTH=10
HTTP_BODY_LIMIT=2097152
